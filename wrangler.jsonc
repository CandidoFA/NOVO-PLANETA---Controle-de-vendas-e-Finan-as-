{
  "name": "novo-planeta---controle-de-vendas-e-finan-as",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Executar sempre o Worker primeiro para impedir que a camada estática devolva HTTP 405 em POST /api/*
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Ligação à base de dados Cloudflare D1 (binding "DB").
  // O Wrangler v4.45+ provisiona/associa automaticamente a D1 quando database_id é omitido;
  // caso já tenha um UUID específico no painel Cloudflare (D1), pode adicioná-lo em "database_id".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novo-planeta-db"
    }
  ]
}
